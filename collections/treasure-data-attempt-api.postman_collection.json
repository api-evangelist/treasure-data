            {
              "name": "Start a workflow execution as a new session or a new attempt of an existing\u2026",
              "id": "dcbe82a3-517c-422e-9c35-c4dd65cd4b01",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"params\": {},\n  \"sessionTime\": \"<dateTime>\",\n  \"allowQueueing\": \"<boolean>\",\n  \"projectName\": \"<string>\",\n  \"resume\": {\n    \"attemptId\": \"<string>\",\n    \"from\": \"<string>\",\n    \"mode\": \"from\"\n  },\n  \"retryAttemptName\": \"<string>\",\n  \"workflowId\": \"<string>\",\n  \"workflowName\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/attempts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "attempts"
                  ]
                },
                "description": "\"resume\" is used to rerun an attempt. It is used in the case an attempt failed then users want to resume it from the middle.It has two modes \"failed\" or \"from\" to set the way to resume.In \"failed\" mode, the attempt specified by \"attemptId\" is resumed from the failed tasks.In \"from\" mode, the attempt is resumed from the task which is set in \"from\" field."
              },
              "response": [
                {
                  "id": "bb02f881-aa85-4cd8-bffa-aa02d84257ff",
                  "name": "return an attempt",
                  "originalRequest": {
