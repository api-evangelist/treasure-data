{
  "opencollection": "1.0.0",
  "info": {
    "name": "Treasure Data TD Bulk Import API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bulk Import",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List bulk import sessions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuredata.com/v3/bulk_import/list"
          },
          "docs": "Returns the list of available bulk import sessions."
        },
        {
          "info": {
            "name": "Create bulk import session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/create/:name/:database_name/:table_name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              },
              {
                "name": "database_name",
                "value": "",
                "type": "path",
                "description": "Target database name"
              },
              {
                "name": "table_name",
                "value": "",
                "type": "path",
                "description": "Target table name"
              }
            ]
          },
          "docs": "Creates a new bulk import session targeting the specified database and table."
        },
        {
          "info": {
            "name": "Show bulk import session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuredata.com/v3/bulk_import/show/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Returns details of the specified bulk import session."
        },
        {
          "info": {
            "name": "Upload bulk import part",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.treasuredata.com/v3/bulk_import/upload_part/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Uploads a msgpack.gz file as a part of the bulk import session."
        },
        {
          "info": {
            "name": "List bulk import parts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuredata.com/v3/bulk_import/list_parts/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Returns the list of uploaded parts for the specified bulk import session."
        },
        {
          "info": {
            "name": "Perform bulk import",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/perform/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Executes the bulk import job for the specified session."
        },
        {
          "info": {
            "name": "Commit bulk import",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/commit/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Finalizes the bulk import session and makes data available."
        },
        {
          "info": {
            "name": "Freeze bulk import session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/freeze/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Prevents further uploads to the specified bulk import session."
        },
        {
          "info": {
            "name": "Unfreeze bulk import session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/unfreeze/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Resumes uploads to the specified frozen bulk import session."
        },
        {
          "info": {
            "name": "Delete bulk import session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.treasuredata.com/v3/bulk_import/delete/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Name of the bulk import session"
              }
            ]
          },
          "docs": "Removes the specified bulk import session."
        }
      ]
    }
  ],
  "bundled": true
}