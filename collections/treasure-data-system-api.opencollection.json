{
  "opencollection": "1.0.0",
  "info": {
    "name": "Treasure Data TD Bulk Import System API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check server health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuredata.com/v3/system/server_status"
          },
          "docs": "Checks the health status of the API load balancer."
        }
      ]
    }
  ],
  "bundled": true
}