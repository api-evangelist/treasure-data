{
  "opencollection": "1.0.0",
  "info": {
    "name": "Treasure Data TD Bulk Import Connectors API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connectors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List output connectors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.treasuredata.com/v3/result/list"
          },
          "docs": "Returns a list of available output connectors."
        }
      ]
    }
  ],
  "bundled": true
}